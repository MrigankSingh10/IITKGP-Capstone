# Set locally; never commit credentials. Endpoints include /v1.
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
CHAT_CA_FILE=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_CA_FILE=
# Optional trace dashboard (Langfuse). Leave the keys empty to keep tracing local only.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SEND_QUERY_TEXT=true
LANGFUSE_ENVIRONMENT=development
